# Feature 007 — shared engine constants for all three test suites (Bash / Java / Python).
#
# Format is plain KEY=VALUE so it can be:
#   - sourced/parsed by the Bash harness (test_bash/harness/docker_engines.sh),
#   - loaded by Java via java.util.Properties (test_java/),
#   - parsed by Python in conftest.py (test_python/).
#
# Every value is overridable by the environment (the harness only applies a key
# from this file when it is not already set in the environment).
#
# Host ports default off 6379 (7379/7380/...) to avoid colliding with a local redis.
# Standalone containers publish 127.0.0.1:<PORT> -> 6379.
# Cluster nodes publish the data port and the bus port (data + 10000), and announce
# 127.0.0.1:<PORT> so JedisCluster / RedisCluster can discover the node over the mapped port.

REDIS_IMAGE=redis:7.4
VALKEY_IMAGE=valkey/valkey:8.0

REDIS_PORT=7379
VALKEY_PORT=7380

REDIS_CLUSTER_PORT=7381
VALKEY_CLUSTER_PORT=7382
